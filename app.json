{
  "expo": {
    "name": "Drum Tune",
    "slug": "drum-tune",
    "version": "1.0.0",
    "icon": "./ic_launcher.png",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#15120F",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Тюнеру нужен доступ к микрофону, чтобы услышать удар по барабану и определить высоту тона."
      }
    },
    "android": {
      "permissions": [
        "RECORD_AUDIO",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ],
      "package": "com.ner0yn.drumtune"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-audio",
        {
          "microphonePermission": "Тюнеру нужен доступ к микрофону, чтобы услышать удар по барабану и определить высоту тона."
        }
      ],
      "expo-asset"
    ],
    "extra": {
      "eas": {
        "projectId": "32728e50-1485-4e85-b354-b7ef4f5427ec"
      }
    }
  }
}
